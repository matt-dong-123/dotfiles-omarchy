**/tmux/plugins/
**/omarchy/plugins/
**/omarchy/themes/rose-pine-moon/

# Editor plugin lockfiles (regenerated by the plugin manager)
**/nvim/lazy-lock.json
**/nvim/lazyvim.json

# Shell/runtime state, not config
**/.zsh_history

# OS/editor cruft
.DS_Store
*.swp
